{
  "manifest_version": 3,
  "name": "AI Radar — Send to Studio",
  "version": "1.2.0",
  "description": "Capture an X or LinkedIn post for AI Radar research, Repurpose, or Write. Manual only — never scrapes in the background and never posts for you.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://*.firebasedatabase.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send this post to Radar Studio"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.linkedin.com/*", "https://linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
}
