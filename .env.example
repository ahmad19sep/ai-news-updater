# Reference only: this project does not automatically load .env files.
# Set these in your terminal or your secret manager; never commit real values.
# Required for the authenticated local Studio (at least eight characters):
STUDIO_LOCAL_PASSCODE=
# Optional persistent signing secret (32+ characters). If omitted, restart expires sessions.
# STUDIO_SESSION_SECRET=
# Optional private file override shared by the local server and pipeline:
# STUDIO_STATE_PATH=
# Local server: python studio_server.py --port 8765 (127.0.0.1 only)
# Run python run_pipeline.py --store local to use this private file.
# Existing Firebase REST integration remains legacy/unverified.
